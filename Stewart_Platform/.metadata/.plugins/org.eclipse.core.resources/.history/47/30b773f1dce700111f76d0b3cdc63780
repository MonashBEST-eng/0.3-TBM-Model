  if (HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL) != HAL_OK) Error_Handler();
  if (HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL) != HAL_OK) Error_Handler();
  if (HAL_TIM_Encoder_Start(&htim8, TIM_CHANNEL_ALL) != HAL_OK) Error_Handler();
  if (HAL_TIM_Encoder_Start(&htim5, TIM_CHANNEL_ALL) != HAL_OK) Error_Handler();
  for (uint8_t i = 0; i < ACTUATOR_COUNT; i++)
      h_bridge[i].enc_last = enc_read(&h_bridge[i]);

  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_GREEN);
  BSP_LED_Init(LED_YELLOW);
  BSP_LED_Init(LED_RED);

  /* Initialize USER push-button, will be used to trigger an interrupt each time it's pressed.*/
  BSP_PB_Init(BUTTON_USER, BUTTON_MODE_EXTI);

  /* Initialize COM1 port (115200, 8 bits (7-bit data + 1 stop bit), no parity */
  BspCOMInit.BaudRate   = 115200;
  BspCOMInit.WordLength = COM_WORDLENGTH_8B;
  BspCOMInit.StopBits   = COM_STOPBITS_1;
  BspCOMInit.Parity     = COM_PARITY_NONE;
  BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
  if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE)
  {
    Error_Handler();
  }

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  minResult current_minSpeed = {0};
  uint32_t last_enc_ms = 0;
  uint32_t last_button_ms = 0U - BUTTON_DEBOUNCE_MS;

  // Banner + 4 blank lines. The status block then rewrites 5 lines upward from the cursor.
  static const char banner[] = "\r\nSTM32H755 six-leg sync started/reset\r\n\r\n\r\n\r\n\r\n";
  uart_write(banner, (uint16_t)(sizeof(banner) - 1U));

  while (1)
  {
	  uint32_t now = HAL_GetTick();

	  // drain the UART buffer (never waits)
	  uart_pump();

	  //------------------- Read encoders + sync every 10 ms ----------------------
	  if ((uint32_t)(now - last_enc_ms) >= CTRL_PERIOD_MS)
	  {
		  last_enc_ms = now;
		  update_encoders();
		  // sync_actuators();
	  }

	  //------------------- Print every 100 ms (updates the same 5 lines) ----------------------
	  if ((uint32_t)(now - last_uart_print_ms) >= PRINT_PERIOD_MS)
	  {
		  last_uart_print_ms = now;

		  // grab speed (ticks per 100 ms, signed) and reset for the next window
		  int32_t s[ACTUATOR_COUNT];
		  for (uint8_t i = 0; i < ACTUATOR_COUNT; i++){
			  s[i] = h_bridge[i].speed_ticks;
			  h_bridge[i].speed_ticks = 0;
			  speeds[i] = (uint32_t)((s[i] < 0) ? -s[i] : s[i]);
		  }
		  // findmin compares magnitudes, so it works extending or retracting
		  current_minSpeed = simple_findmin(speeds, ACTUATOR_COUNT);
		  print_status(s, current_minSpeed);
	  }

	  //------------------- Button: step through motor states (debounced) ----------------------
	  if (button_event)
	  {
		  button_event = 0U;
		  if ((uint32_t)(now - last_button_ms) >= BUTTON_DEBOUNCE_MS)
		  {
			  last_button_ms = now;
			  handle_button();
		  }
	  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

