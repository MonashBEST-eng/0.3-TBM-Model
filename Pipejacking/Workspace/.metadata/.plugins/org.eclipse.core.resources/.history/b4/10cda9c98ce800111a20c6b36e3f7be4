	                 (long)actuator_state[ACTUATOR_A].dist, (int)actuator_state[ACTUATOR_A].status,
	                 (long)actuator_state[ACTUATOR_B].dist, (int)actuator_state[ACTUATOR_B].status,
	                 (long)actuator_state[ACTUATOR_C].dist, (int)actuator_state[ACTUATOR_C].status,
	                 (long)actuator_state[ACTUATOR_D].dist, (int)actuator_state[ACTUATOR_D].status);
	if (n < 0) return;
	if (n >= (int)sizeof(buf)) n = (int)sizeof(buf) - 1;
	HAL_UART_Transmit(&hcom_uart[COM1], (uint8_t *)buf, (uint16_t)n, 100);
}

