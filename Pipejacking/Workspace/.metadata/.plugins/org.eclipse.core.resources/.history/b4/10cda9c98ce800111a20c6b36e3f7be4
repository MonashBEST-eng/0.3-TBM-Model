/**
  * Control code for four HTW77 linear actuators, driven by HC106AS2 H-bridge controllers.
  *
  * Per actuator:
  *   IN1/IN2 (GPIOC)   -> direction
  *   TIM1_CHx PWM      -> speed
  *   TIMx encoder      -> Hall A/B quadrature, counted in hardware
  *
  * Pin / timer map (see .ioc):
  *   A: PWM TIM1_CH1 (PC0)  Hall TIM2 (PA0, PA1)
  *   B: PWM TIM1_CH2 (PA9)  Hall TIM3 (PA6, PA4)
  *   C: PWM TIM1_CH3 (PA10) Hall TIM4 (PA11, PA12)
  *   D: PWM TIM1_CH4 (PC3)  Hall TIM8 (PA15, PB8)   <- PB8 is BOOT0, see notes
  *
  * Usage:
  *   actuators_home_all();                         // drive to retracted end stop, zero counts
  *   actuator_goto_mm(ACTUATOR_A, 120.0f, 0.5f, true);
  *   actuator_move_mm(ACTUATOR_B, -20.0f, 0.5f, true);
  *   actuators_wait();                             // runs actuators_tick() until all moves end
  */
/* USER CODE END Header */
