/* ======================= Motor driver ======================= */

/**
  * Set direction and speed of one actuator.
  *  - CMD_STOP always succeeds (the duty value is ignored) and zeroes that actuator's PWM.
  *  - safety = true: clear this actuator's direction pins and wait DEAD_TIME_MS before
  *    applying the new direction (use on every direction change). Blocks, so never call
  *    it from an ISR. Other running actuators are not ticked during the wait.
  */
static HAL_StatusTypeDef motor_set(ActuatorCommand_t cmd,
                                   float duty,
                                   bool safety,
                                   ActuatorId_t id)
{
	if (cmd != CMD_STOP && cmd != CMD_FORWARD && cmd != CMD_REVERSE) return HAL_ERROR;
	if ((unsigned)id >= ACTUATOR_COUNT) return HAL_ERROR;

	const ActuatorCfg_t *p = &actuator_cfg[id];

	// Always cut this actuator's PWM first
	__HAL_TIM_SET_COMPARE(&htim1, p->pwm_channel, 0);

	if (cmd == CMD_STOP)
	{
		HAL_GPIO_WritePin(PIN_PORT, p->pin_in1 | p->pin_in2, GPIO_PIN_RESET);
		return HAL_OK;
	}

	// Reject bad duty (also rejects NaN). PWM is already 0, so this fails safe.
	if (!(duty >= 0.0f && duty <= MAX_DUTY)) return HAL_ERROR;

	// Optional dead time for this actuator only
	if (safety)
	{
		HAL_GPIO_WritePin(PIN_PORT, p->pin_in1 | p->pin_in2, GPIO_PIN_RESET);
		HAL_Delay(DEAD_TIME_MS);
	}

	// Direction: bit 1 -> IN1, bit 0 -> IN2
	HAL_GPIO_WritePin(PIN_PORT, p->pin_in1, (cmd & 0b10) ? GPIO_PIN_SET : GPIO_PIN_RESET);
	HAL_GPIO_WritePin(PIN_PORT, p->pin_in2, (cmd & 0b01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

	// Speed, scaled from the timer's real auto-reload value
	uint32_t arr = __HAL_TIM_GET_AUTORELOAD(&htim1);
	__HAL_TIM_SET_COMPARE(&htim1, p->pwm_channel, (uint32_t)(duty * (float)(arr + 1U)));

	return HAL_OK;
}

/* ======================= Position (Hall sensors) ======================= */

/**
  * Fold the hardware encoder counters into each actuator's accumulated position.
  * The 16-bit subtraction handles counter wraparound. Call this often enough that an
  * actuator can't move more than 32767 counts between calls. Single caller only.
  */
static void position_update(void)
{
	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		if (!actuator_cfg[i].enc_tim) continue;

		uint16_t now   = (uint16_t)__HAL_TIM_GET_COUNTER(actuator_cfg[i].enc_tim);
		int16_t  delta = (int16_t)(now - actuator_state[i].last_cnt);

		actuator_state[i].last_cnt = now;
		actuator_state[i].dist    += delta;
	}
}

static void actuators_init(void)
{
	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		actuator_state[i].dist     = 0;
		actuator_state[i].homed    = false;
		actuator_state[i].status   = MOVE_IDLE;
		actuator_state[i].last_cnt = (uint16_t)__HAL_TIM_GET_COUNTER(actuator_cfg[i].enc_tim);
	}
}

/* ======================= Moves ======================= */

static void actuators_stop_all(void)
{
	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		motor_set(CMD_STOP, 0.0f, false, (ActuatorId_t)i);
		if (actuator_state[i].status == MOVE_RUNNING) actuator_state[i].status = MOVE_IDLE;
	}
}

// Backstop time for a move: generous multiple of the ideal time at this duty
static uint32_t move_timeout_ms(float abs_mm, float duty)
{
	return (uint32_t)(abs_mm / MAX_SPEED_MM_S / duty * 1000.0f * 2.0f) + 2000U;
}

/**
  * Start a move of `counts` (signed) from the current position. Does not wait.
  * Once homed, targets outside 0..STROKE_COUNTS are rejected.
  */
static HAL_StatusTypeDef start_move(ActuatorId_t id, int32_t counts, float duty,
                                    bool safety, uint32_t timeout_ms)
{
	if ((unsigned)id >= ACTUATOR_COUNT) return HAL_ERROR;
	if (!(duty >= MIN_MOVE_DUTY && duty <= MAX_DUTY)) return HAL_ERROR;   // also rejects NaN

	position_update();    // make sure dist is current before computing the target

	ActuatorState_t *s = &actuator_state[id];

	if (counts == 0)
	{
		s->status = MOVE_DONE;
		return HAL_OK;
	}

	int32_t target = s->dist + counts;
	if (s->homed && (target < 0 || target > STROKE_COUNTS)) return HAL_ERROR;

	s->dir    = (counts > 0) ? 1 : -1;
	s->target = target;
	s->duty   = duty;

	HAL_StatusTypeDef st = motor_set(s->dir > 0 ? CMD_FORWARD : CMD_REVERSE, duty, safety, id);
	if (st != HAL_OK) return st;

	// Take timestamps AFTER motor_set, since safety = true blocks for DEAD_TIME_MS
	uint32_t now      = HAL_GetTick();
	s->prev_dist      = s->dist;
	s->start_ms       = now;
	s->last_change_ms = now;
	s->timeout_ms     = timeout_ms;
	s->slowed         = false;
	s->status         = MOVE_RUNNING;
	return HAL_OK;
}

// Move by a relative distance in mm (negative = retract)
static HAL_StatusTypeDef actuator_move_mm(ActuatorId_t id, float mm, float duty, bool safety)
{
	if (!(fabsf(mm) <= STROKE_MM)) return HAL_ERROR;   // also rejects NaN
	if (!(duty >= MIN_MOVE_DUTY)) return HAL_ERROR;    // keeps the timeout calculation finite

	int32_t counts = (int32_t)lroundf(mm * COUNTS_PER_MM);   // round to the nearest Hall count
	return start_move(id, counts, duty, safety, move_timeout_ms(fabsf(mm), duty));
}

// Move to an absolute position in mm (0 = fully retracted). Requires homing first.
static HAL_StatusTypeDef actuator_goto_mm(ActuatorId_t id, float abs_mm, float duty, bool safety)
{
	if ((unsigned)id >= ACTUATOR_COUNT) return HAL_ERROR;
	if (!actuator_state[id].homed) return HAL_ERROR;
	if (!(abs_mm >= 0.0f && abs_mm <= STROKE_MM)) return HAL_ERROR;   // also rejects NaN
	if (!(duty >= MIN_MOVE_DUTY)) return HAL_ERROR;

	position_update();
	int32_t target = (int32_t)lroundf(abs_mm * COUNTS_PER_MM);
	int32_t counts = target - actuator_state[id].dist;
	float   mm     = fabsf((float)counts) / COUNTS_PER_MM;
	return start_move(id, counts, duty, safety, move_timeout_ms(mm, duty));
}

/**
  * Run every pending move. Call at a fixed, fast rate (the encoders keep counting in
  * hardware, but stops are only checked here). Never blocks, and only uses
  * motor_set(CMD_STOP, ...), so it is ISR-safe if position_update() has a single caller.
  */
static void actuators_tick(void)
{
	position_update();
	uint32_t now = HAL_GetTick();

	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		ActuatorState_t *s = &actuator_state[i];
		if (s->status != MOVE_RUNNING) continue;

		int32_t remaining = (s->target - s->dist) * s->dir;   // counts still to go

		if (remaining <= 0)                                   // arrived
		{
			motor_set(CMD_STOP, 0.0f, false, (ActuatorId_t)i);
			s->status = MOVE_DONE;
			continue;
		}

		if (s->dist != s->prev_dist)                          // still moving
		{
			s->prev_dist      = s->dist;
			s->last_change_ms = now;
		}
		else if ((now - s->last_change_ms) > STALL_MS)        // no counts: stalled
		{
			motor_set(CMD_STOP, 0.0f, false, (ActuatorId_t)i);
			s->status = MOVE_STALLED;
			continue;
		}

		if ((now - s->start_ms) > s->timeout_ms)              // overall backstop
		{
			motor_set(CMD_STOP, 0.0f, false, (ActuatorId_t)i);
			s->status = MOVE_TIMEOUT;
			continue;
		}

		if (!s->slowed && remaining < SLOW_COUNTS)            // ease in to reduce overshoot
		{
			s->slowed = true;
			if (s->duty > SLOW_DUTY)
			{
				uint32_t arr = __HAL_TIM_GET_AUTORELOAD(&htim1);
				__HAL_TIM_SET_COMPARE(&htim1, actuator_cfg[i].pwm_channel,
				                      (uint32_t)(SLOW_DUTY * (float)(arr + 1U)));
			}
		}
	}
}

static bool actuators_busy(void)
{
	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		if (actuator_state[i].status == MOVE_RUNNING) return true;
	}
	return false;
}


static void calibrate_stroke(ActuatorId_t id)
{
    char buf[96];
    const float duty = 0.4f;                               // slow and gentle
    uint32_t timeout = move_timeout_ms(STROKE_MM + HOME_MARGIN_MM, duty);
    ActuatorState_t *s = &actuator_state[id];

    // 1. Retract to the end stop and zero
    s->homed = false;
    if (start_move(id, HOME_FAR_COUNTS, duty, false, timeout) != HAL_OK) Error_Handler();
    while (s->status == MOVE_RUNNING) { actuators_tick(); HAL_Delay(5); }
    if (s->status != MOVE_STALLED) Error_Handler();        // never found the stop
    position_update();
    s->dist = 0;
    HAL_Delay(2000);

    // 2. Extend to the far end stop
    if (start_move(id, -HOME_FAR_COUNTS, duty, true, timeout) != HAL_OK) Error_Handler();
    while (s->status == MOVE_RUNNING) { actuators_tick(); HAL_Delay(5); }
    position_update();

    // 3. Report
    int n = snprintf(buf, sizeof buf, "status=%d full-stroke counts=%ld\r\n",
                     (int)s->status, (long)s->dist);
    HAL_UART_Transmit(&hcom_uart[COM1], (uint8_t *)buf, (uint16_t)n, 100);
    motor_set(CMD_STOP, 0.0f, false, id);
}


// Block until every move has finished, stalled or timed out
static void actuators_wait(void)
{
	while (actuators_busy())
	{
		actuators_tick();
		HAL_Delay(5);
	}
}

/* ======================= Homing ======================= */

/**
  * Reverse every actuator at HOME_DUTY until it stalls against the retracted end,
  * then zero its position and mark it homed. Any actuator that doesn't stall
  * (timeout) fails homing. All four run at once, so check the 48 V supply can
  * handle the combined current, and note the 2 min on / 18 min off duty rating.
  */
static HAL_StatusTypeDef actuators_home_all(void)
{
	uint32_t timeout = move_timeout_ms(STROKE_MM + HOME_MARGIN_MM, HOME_DUTY);

	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		actuator_state[i].homed = false;    // disable range checks while homing
		if (start_move((ActuatorId_t)i, HOME_FAR_COUNTS, HOME_DUTY, false, timeout) != HAL_OK)
		{
			actuators_stop_all();
			return HAL_ERROR;
		}
	}

	actuators_wait();

	HAL_StatusTypeDef result = HAL_OK;
	position_update();
	for (int i = 0; i < ACTUATOR_COUNT; i++)
	{
		ActuatorState_t *s = &actuator_state[i];
		if (s->status == MOVE_STALLED)      // stalled on the end stop = at position 0
		{
			s->dist   = 0;
			s->homed  = true;
			s->status = MOVE_DONE;
		}
		else
		{
			result = HAL_ERROR;             // timed out or otherwise failed to find the stop
		}
	}

	if (result != HAL_OK) actuators_stop_all();
	return result;
}

