// ---------- MOTOR COMMANDS -----------
typedef enum {
	CMD_STOP    = 0b00,
	CMD_FORWARD = 0b10,   // bit 1 -> IN1
	CMD_REVERSE = 0b01,   // bit 0 -> IN2
} ActuatorCommand_t;

typedef enum {
	ACTUATOR_A,
	ACTUATOR_B,
	ACTUATOR_C,
	ACTUATOR_D,
	ACTUATOR_COUNT        // keep last: number of actuators
} ActuatorId_t;

typedef enum {
	MOVE_IDLE,
	MOVE_RUNNING,
	MOVE_DONE,
	MOVE_STALLED,
	MOVE_TIMEOUT
} MoveStatus_t;

// Constant configuration (lives in flash)
typedef struct {
	uint16_t           pin_in1;      // GPIO mask, all direction pins are on PIN_PORT
	uint16_t           pin_in2;
	uint32_t           pwm_channel;  // TIM_CHANNEL_x on TIM1 (NOT a GPIO pin)
	TIM_HandleTypeDef *enc_tim;      // encoder timer for this actuator's Hall sensors
} ActuatorCfg_t;

// Mutable runtime state (lives in RAM)
typedef struct {
	int32_t      dist;            // accumulated encoder counts, + = forward
	uint16_t     last_cnt;        // raw counter value at the last position_update()
	bool         homed;           // dist == 0 means fully retracted, once homed

	int32_t      target;          // target position in counts
	int32_t      prev_dist;       // for stall detection
	int8_t       dir;             // +1 forward, -1 reverse
	float        duty;            // duty requested for the current move
	MoveStatus_t status;
	uint32_t     start_ms;
	uint32_t     last_change_ms;
	uint32_t     timeout_ms;
	bool         slowed;
} ActuatorState_t;

typedef struct {
	float KP;
	float KI;
	float KD;

} ActuatorPID;

