static HAL_StatusTypeDef motor_set(ActuatorCommand_t cmd, float duty, bool safety)
{
    // Reject bad input before touching the motor
    if (duty < 0.0f || duty > 0.98f) return HAL_ERROR;
    if (cmd != CMD_STOP && cmd != CMD_FORWARD && cmd != CMD_REVERSE) return HAL_ERROR;

    // Always stop first: PWM off, both direction pins low (brake)
    if (safety){
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
        HAL_GPIO_WritePin(PIN_PORT, PIN_A1 | PIN_A2, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(PIN_PORT, PIN_B1 | PIN_B2, GPIO_PIN_RESET);
        HAL_Delay(100);  // dead time
    }


    if (cmd == CMD_STOP) return HAL_OK;

    // Direction: bit 1 -> A, bit 0 -> B
    HAL_GPIO_WritePin(PIN_PORT, PIN_A1, (cmd & 0b10) ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(PIN_PORT, PIN_A2, (cmd & 0b01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    HAL_GPIO_WritePin(PIN_PORT, PIN_B1, (cmd & 0b10) ? GPIO_PIN_SET : GPIO_PIN_RESET);
    HAL_GPIO_WritePin(PIN_PORT, PIN_B2, (cmd & 0b01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

    // Speed
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)(duty * (ARR + 1)));

    return HAL_OK;
}


